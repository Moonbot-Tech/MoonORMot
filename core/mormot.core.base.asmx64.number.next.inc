        sub     r8d, 48
        cmp     r8d, 9
        jbe     @nil
        jmp     @jsonStartChecked
@rawFraction:
        lea     r9d, [rax + 1]
        cmp     r10d, r9d
        jne     @jsonFractionChecked
        cmp     r10d, 16
        jne     @nil
        movzx   r9d, byte ptr [rcx + 16]
        sub     r9d, 48
        cmp     r9d, 9
        ja      @nil
        jmp     @jsonFractionChecked
end;

