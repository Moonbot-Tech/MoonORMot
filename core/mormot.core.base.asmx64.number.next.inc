        cmp     r10d, 9
        jbe     @zeroInvalid
        jmp     @startChecked
@shortDelimiter:
        cmp     dword ptr [rsp + 16], 256
        jne     @invalid
        lea     r8, [rip + JsonEndErrors]
        cmp     byte ptr [r8 + r9], 0
        jne     @invalid
        test    r11b, 1
        jnz     @negate
        mov     r8, [rsp + 8]
        mov     [r8], rcx
        ret
@longDelimiter:
        cmp     dword ptr [rsp + 16], 256
        jne     @invalid
        lea     r8, [rip + JsonEndErrors]
        cmp     byte ptr [r8 + r10], 0
        jne     @invalid
        jmp     @range
end;
